{
  "_meta": {
    "version": "1.0.0",
    "description": "WoS Battle Simulator - Hero Definitions",
    "notes": {
      "base_stats": "Percentage buffs applied to army stats (e.g. 200.16% = 2.0016 multiplier)",
      "exclusive_gear_scaling": "Skill effect values are given at 5 step points. Map to levels 1-10 via step function: Lv1-2=step1, Lv3-4=step2, Lv5-6=step3, Lv7-8=step4, Lv9-10=step5",
      "exclusive_gear_base_stats": "Lethality/HP max values scale linearly from 0 at Lv0 to max at Lv10. Per-level = max * (level / 10)",
      "side": "attack = applies when hero's army is attacking; defense = applies when hero's army is defending",
      "skill_trigger_types": [
        "passive",
        "on_turn_start",
        "on_attack",
        "on_receive_damage",
        "every_n_turns",
        "every_n_attacks",
        "on_every_attack"
      ],
      "skill_target_types": [
        "ally_all",
        "enemy_all",
        "ally_rally",
        "self_unit",
        "primary_target"
      ],
      "duration_rules": "passive→null(永続), on_turn_start/on_attack等の確率系→1(発動ターンのみ), every_n_turns→明示整数",
      "effect_types_extended": [
        "damage_taken_up: 単体被ダメ増デバフ, duration_hits で持続ヒット数指定",
        "target_vulnerability: 脆弱付与, 次攻撃の追加ダメ枠に加算",
        "aoe_extra_damage: 全敵追加ダメージ",
        "attack_count_extra_damage: 攻撃回数トリガーの追加ダメージ"
      ],
      "rarity_rules": "legend = ラリーリーダー・メンバー両方可, epic = メンバーのみ（ラリーリーダー不可）"
    }
  },
